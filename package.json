{
  "name": "SuperM",
  "version": "1.0.0",
  "description": "SuperM retail management desktop app",
  "main": "electron/main.js",
  "scripts": {
    "build:frontend": "npm --prefix frontend run build",
    "start": "electron .",
    "dist": "npm run build:frontend && electron-builder --win",
    "package:portable": "npm run build:frontend && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.7.1",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.superm.desktop",
    "productName": "SuperM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "frontend/build",
        "to": "frontend/build"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
