{
  "name": "SuperM",
  "version": "1.10.0",
  "description": "SuperM retail management desktop app",
  "main": "electron/main.js",
  "scripts": {
    "build:frontend": "npm --prefix frontend run build",
    "start": "electron .",
    "dist": "npm run build:frontend && electron-builder --win",
    "package:portable": "npm run build:frontend && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.7.1",
    "electron-builder": "^24.13.0"
  },
  "build": {
    "appId": "com.superm.desktop",
    "productName": "SuperM",
    "directories": {
      "output": "dist-1.10.0-final"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "src/**/*",
          "node_modules/**/*",
          "uploads/**/*",
          "package.json",
          ".env"
        ]
      },
      {
        "from": "frontend/build",
        "to": "frontend/build"
      }
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  }
}
